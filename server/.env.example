# CIPHER server environment
# Copy this file to ".env" and fill in your values.

# Postgres connection string (required — user data lives here now, not db.json).
# Local:  postgres://user:password@localhost:5432/cipher
# Neon:    postgresql://user:password@ep-xxx.region.aws.neon.tech/cipher?sslmode=require
# The users table auto-creates on boot — no manual SQL needed.
DATABASE_URL=postgres://user:password@localhost:5432/cipher
# Override SSL auto-detection: PGSSL=true forces SSL, PGSSL=false disables it.
# (Auto: SSL on for hosted URLs, off for localhost.)

# A Gmail App Password (NOT your normal password).
# Create one: Google Account → Security → 2-Step Verification → App passwords
GMAIL_USER=your.address@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Any long random string — used to sign login tokens
JWT_SECRET=change-this-to-a-long-random-string

# API port
PORT=4000

